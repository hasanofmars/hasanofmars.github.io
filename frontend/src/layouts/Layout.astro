---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | M Hasan</title>
    <meta name="description" content={description || "M Hasan - Full Stack Developer & Cybersecurity Expert"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="grid-bg"></div>
    <script>
      // API base URL - auto-detects dev vs Cloudflare Pages
      (function() {
        var host = window.location.hostname;
        var isDev = host === 'localhost' || host === '127.0.0.1';
        // Update this URL to your deployed backend (Render, Railway, etc.)
        window.API_BASE = isDev
          ? 'http://localhost:8000'
          : 'https://portfolio-api.onrender.com';
        window.API_READY = true;
      })();

      // Load avatar from backend API (runs on every page)
      (function() {
        var API = window.API_BASE || 'http://localhost:8000';
        fetch(API + '/api/profile/')
          .then(function(r) { return r.json(); })
          .then(function(profile) {
            if (profile && profile.avatar_url) {
              var url = profile.avatar_url;
              // If it's a frontend static path, use it directly (don't proxy through backend)
              if (url.startsWith('/images/')) {
                // Already correct — served from frontend static files
              } else if (!url.startsWith('http')) {
                url = API + url;
              }
              var avatars = document.querySelectorAll('.hero-avatar-img, .avatar-img, .topbar-avatar');
              for (var i = 0; i < avatars.length; i++) {
                if (avatars[i].tagName === 'IMG') {
                  avatars[i].src = url;
                }
              }
            }
          })
          .catch(function() { /* use fallback images */ });
      })();
    </script>
    <slot />
  </body>
</html>
