---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | M Hasan</title>
    <meta name="description" content={description || "M Hasan - Full Stack Developer & Cybersecurity Expert"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="grid-bg"></div>
    <script>
      // API base URL - connects to local FastAPI backend
      window.API_BASE = 'http://localhost:8000';
      window.API_READY = true;

      // Load avatar from backend API (runs on every page)
      (function() {
        var API = window.API_BASE || 'http://localhost:8000';
        fetch(API + '/api/profile/')
          .then(function(r) { return r.json(); })
          .then(function(profile) {
            if (profile && profile.avatar_url) {
              var avatars = document.querySelectorAll('.hero-avatar-img, .avatar-img, .topbar-avatar');
              for (var i = 0; i < avatars.length; i++) {
                if (avatars[i].tagName === 'IMG') {
                  avatars[i].src = profile.avatar_url.startsWith('http')
                    ? profile.avatar_url
                    : API + profile.avatar_url;
                }
              }
            }
          })
          .catch(function() { /* use fallback images */ });
      })();
    </script>
    <slot />
  </body>
</html>
