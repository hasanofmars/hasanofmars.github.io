---
export interface Props {
  title: string;
  excerpt: string;
  date: string;
  category: string;
  tags: string[];
  readingTime: string;
  slug: string;
  featured?: boolean;
  index?: number;
}

const { title, excerpt, date, category, tags, readingTime, slug, featured = false, index = 0 } = Astro.props;
const delay = index * 0.1;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article class={`blog-card ${featured ? 'blog-card--featured' : ''}`} style={`animation-delay: ${delay}s`}>
  <a href={`/blog/${slug}`} class="blog-card-link">
    <div class="blog-card-meta">
      <span class="blog-card-category">{category}</span>
      <span class="blog-card-date">{formattedDate}</span>
      <span class="blog-card-dot">·</span>
      <span class="blog-card-reading-time">{readingTime}</span>
    </div>
    <h3 class="blog-card-title">{title}</h3>
    <p class="blog-card-excerpt">{excerpt}</p>
    <div class="blog-card-tags">
      {tags.map(tag => <span class="blog-card-tag">{tag}</span>)}
    </div>
    <span class="blog-card-readmore">
      Read more
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </span>
  </a>
</article>

<style>
  .blog-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: var(--transition);
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
    overflow: hidden;
  }

  .blog-card:hover {
    border-color: var(--accent-green);
    transform: translateY(-4px);
    box-shadow: var(--shadow-green);
  }

  .blog-card--featured {
    border-color: rgba(0, 255, 65, 0.2);
  }

  .blog-card-link {
    display: block;
    padding: 32px;
    color: inherit;
    text-decoration: none;
  }

  .blog-card:hover .blog-card-link {
    color: inherit;
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .blog-card-category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-green);
    background: rgba(0, 255, 65, 0.08);
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid rgba(0, 255, 65, 0.15);
  }

  .blog-card-date,
  .blog-card-reading-time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .blog-card-dot {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .blog-card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.3;
    transition: var(--transition);
  }

  .blog-card:hover .blog-card-title {
    color: var(--accent-green);
  }

  .blog-card-excerpt {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .blog-card-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    background: rgba(148, 163, 184, 0.08);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }

  .blog-card-readmore {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-green);
    transition: var(--transition);
  }

  .blog-card-readmore svg {
    width: 16px;
    height: 16px;
    transition: var(--transition);
  }

  .blog-card:hover .blog-card-readmore {
    gap: 10px;
  }

  @media (max-width: 480px) {
    .blog-card-link {
      padding: 20px;
    }
    .blog-card-title {
      font-size: 1.1rem;
    }
    .blog-card-excerpt {
      font-size: 0.85rem;
    }
    .blog-card-meta {
      gap: 6px;
    }
  }
</style>
