---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Home">
  <Navbar />

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-layout">
        <div class="hero-content">
          <div class="hero-badge" id="heroBadge">
            <span class="badge-dot"></span>
            <span class="badge-text">Cybersecurity Expert & Developer</span>
          </div>
          <h1 class="hero-title" id="heroTitle">
            Hi, I'm <span class="gradient-text">M Hasan</span>
          </h1>
          <div class="hero-typing">
            <span class="typing-text" id="heroTyping">I build secure & scalable web solutions</span>
          </div>
          <p class="hero-desc" id="heroDesc">
            Full Stack Developer & Cybersecurity Expert based in <strong>Dhaka, Bangladesh</strong>.
            Passionate about building secure, high-performance web applications and protecting digital infrastructure.
          </p>
          <div class="hero-actions">
            <a href="/projects" class="btn btn-primary">View Projects</a>
            <a href="/contact" class="btn btn-outline">Contact Me</a>
          </div>
          <div class="hero-stats" id="heroStats">
            <div class="stat-item">
              <span class="stat-number">5+</span>
              <span class="stat-label">Years Experience</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">50+</span>
              <span class="stat-label">Projects Done</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">100+</span>
              <span class="stat-label">Happy Clients</span>
            </div>
          </div>
        </div>
        <div class="hero-avatar-wrapper">
          <div class="hero-avatar-frame">
            <img src="/images/profile.jpg" alt="M Hasan" class="hero-avatar-img" />
            <div class="hero-avatar-ring"></div>
          </div>
          <div class="hero-avatar-glow"></div>
          <div class="hero-status">
            <span class="status-dot"></span>
            Available for projects
          </div>
        </div>
      </div>
    </div>
    <div class="hero-particles">
      <div class="particle" style="top:20%;left:10%;animation-delay:0s"></div>
      <div class="particle" style="top:40%;left:85%;animation-delay:1s"></div>
      <div class="particle" style="top:70%;left:20%;animation-delay:2s"></div>
      <div class="particle" style="top:30%;left:70%;animation-delay:0.5s"></div>
      <div class="particle" style="top:80%;left:75%;animation-delay:1.5s"></div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section featured-section">
    <div class="container">
      <h2 class="section-title" id="featuredTitle">Featured <span class="gradient-text">Projects</span></h2>
      <p class="section-subtitle" id="featuredSubtitle">Highlighting my most impactful work in cybersecurity and web development</p>
      <div class="projects-grid" id="featuredGrid">
      </div>
      <div class="text-center" style="text-align:center;margin-top:40px;">
        <a href="/projects" class="btn btn-outline">View All Projects →</a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section services-section">
    <div class="container">
      <h2 class="section-title" id="servicesTitle">What I <span class="gradient-text">Do</span></h2>
      <p class="section-subtitle" id="servicesSubtitle">Comprehensive cybersecurity and development services</p>
      <div class="services-grid" id="servicesGrid">
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style is:global>
  /* ===== Hero ===== */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: 70px;
  }

  .hero-layout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
  }

  .hero-content {
    flex: 1;
    max-width: 640px;
    position: relative;
    z-index: 2;
  }

  /* ===== Hero Avatar ===== */
  .hero-avatar-wrapper {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    position: relative;
    z-index: 2;
  }

  .hero-avatar-frame {
    position: relative;
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-avatar-img {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--border-color);
    z-index: 2;
    position: relative;
    transition: var(--transition);
  }

  .hero-avatar-img:hover {
    border-color: var(--accent-green);
    transform: scale(1.02);
  }

  .hero-avatar-ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 2.5px solid transparent;
    background: linear-gradient(135deg, var(--accent-green), var(--accent-cyan), var(--accent-purple)) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: heroSpin 8s linear infinite;
  }

  @keyframes heroSpin {
    to { transform: rotate(360deg); }
  }

  .hero-avatar-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 255, 65, 0.1), transparent 70%);
    filter: blur(20px);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hero-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-green);
    background: rgba(0, 255, 65, 0.08);
    border: 1px solid rgba(0, 255, 65, 0.2);
    padding: 8px 18px;
    border-radius: 50px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-green);
    border-radius: 50%;
    animation: pulse 2s infinite;
    box-shadow: 0 0 8px var(--accent-green);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 255, 65, 0.1);
    border: 1px solid rgba(0, 255, 65, 0.2);
    padding: 8px 16px;
    border-radius: 50px;
    margin-bottom: 30px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-green);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-green);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .hero-title {
    font-size: 4.5rem;
    font-weight: 800;
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .hero-typing {
    margin-bottom: 24px;
  }

  .typing-text {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--text-secondary);
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid var(--accent-green);
    animation: typing 3s steps(40) 1s 1 normal both, blink 0.8s step-end infinite;
    max-width: fit-content;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 36px;
    max-width: 600px;
  }

  .hero-desc strong {
    color: var(--accent-green);
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 60px;
  }

  .hero-stats {
    display: flex;
    gap: 50px;
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-family: var(--font-mono);
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--accent-green);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent-green), 0 0 12px var(--accent-green);
    animation: float 6s ease-in-out infinite;
    opacity: 0.5;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); opacity: 0.5; }
    50% { transform: translateY(-30px) scale(1.5); opacity: 1; }
  }

  /* ===== Featured Projects ===== */
  .featured-section {
    background: var(--bg-secondary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
  }

  .featured-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 32px;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
  }

  .featured-card:hover {
    border-color: var(--accent-green);
    transform: translateY(-4px);
    box-shadow: var(--shadow-green);
  }

  .fc-icon {
    width: 48px;
    height: 48px;
    background: rgba(0, 255, 65, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: var(--accent-green);
  }

  .fc-icon svg,
  .service-icon svg {
    width: 24px;
    height: 24px;
  }

  .featured-card h3 {
    font-size: 1.2rem;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .featured-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .fc-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .fc-tech span {
    background: rgba(0, 212, 255, 0.08);
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 3px 10px;
    border-radius: 4px;
    border: 1px solid rgba(0, 212, 255, 0.15);
  }

  .fc-actions {
    display: flex;
    gap: 10px;
  }

  /* ===== Services ===== */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .service-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 28px;
    transition: var(--transition);
    text-align: center;
  }

  .service-card:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .service-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    background: rgba(0, 212, 255, 0.1);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
  }

  .service-icon svg {
    width: 28px;
    height: 28px;
  }

  .service-card h3 {
    font-size: 1.1rem;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .service-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .hero-layout {
      flex-direction: column-reverse;
      text-align: center;
      gap: 40px;
    }
    .hero-content {
      max-width: 100%;
    }
    .hero-badge {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-desc {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-stats {
      justify-content: center;
    }
    .hero-avatar-frame {
      width: 200px;
      height: 200px;
    }
    .hero-avatar-img {
      width: 184px;
      height: 184px;
    }
    .hero-avatar-glow {
      width: 220px;
      height: 220px;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.8rem;
    }
    .typing-text {
      font-size: 1rem;
      white-space: normal;
      border-right: none;
      animation: none;
    }
    .hero-layout {
      gap: 30px;
    }
    .hero-avatar-frame {
      width: 160px;
      height: 160px;
    }
    .hero-avatar-img {
      width: 148px;
      height: 148px;
    }
    .hero-avatar-glow {
      width: 180px;
      height: 180px;
    }
    .hero-stats {
      gap: 30px;
    }
    .stat-number {
      font-size: 1.5rem;
    }
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const API = window.API_BASE || 'http://localhost:8000';

  async function loadHomepage() {
    try {
      const res = await fetch(`${API}/api/homepage/`);
      const data = await res.json();
      if (data.hero_badge) document.querySelector('#heroBadge .badge-text').textContent = data.hero_badge;
      if (data.hero_title) document.querySelector('#heroTitle').innerHTML = data.hero_title.replace('M Hasan', '<span class="gradient-text">M Hasan</span>');
      if (data.hero_typing) document.querySelector('#heroTyping').textContent = data.hero_typing;
      if (data.hero_description) document.querySelector('#heroDesc').innerHTML = data.hero_description.replace(/Dhaka, Bangladesh/g, '<strong>Dhaka, Bangladesh</strong>');
      if (data.hero_status) document.querySelector('.hero-status').innerHTML = `<span class="status-dot"></span> ${data.hero_status}`;
      if (data.stats && data.stats.length) {
        document.querySelector('#heroStats').innerHTML = data.stats.map(s =>
          `<div class="stat-item"><span class="stat-number">${s.number}</span><span class="stat-label">${s.label}</span></div>`
        ).join('');
      }
      if (data.featured_title) document.querySelector('#featuredTitle').innerHTML = data.featured_title.replace(/Projects$/, '<span class="gradient-text">Projects</span>');
      if (data.featured_subtitle) document.querySelector('#featuredSubtitle').textContent = data.featured_subtitle;
      if (data.services_title) document.querySelector('#servicesTitle').innerHTML = data.services_title.replace(/Do$/, '<span class="gradient-text">Do</span>');
      if (data.services_subtitle) document.querySelector('#servicesSubtitle').textContent = data.services_subtitle;
    } catch (e) { console.log('Homepage API unavailable'); }
  }

  async function loadFeaturedProjects() {
    try {
      const res = await fetch(`${API}/api/projects/featured`);
      let projects = await res.json();
      if (!projects.length) {
        const allRes = await fetch(`${API}/api/projects/`);
        projects = (await allRes.json()).slice(0, 3);
      }
      const grid = document.querySelector('#featuredGrid');
      if (projects.length) {
        grid.innerHTML = projects.slice(0, 3).map(p => `
          <article class="featured-card">
            <div class="fc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
            <h3>${p.title}</h3>
            <p>${p.description || ''}</p>
            <div class="fc-tech">${(p.tech_stack || '').split(',').map(t => `<span>${t.trim()}</span>`).join('')}</div>
            <div class="fc-actions">
              ${p.live_url ? `<a href="${p.live_url}" class="btn btn-primary btn-small">Live Demo</a>` : ''}
              ${p.github_url ? `<a href="${p.github_url}" class="btn btn-outline btn-small">Source</a>` : ''}
            </div>
          </article>
        `).join('');
      }
    } catch (e) { console.log('Featured projects API unavailable'); }
  }

  async function loadServices() {
    try {
      const res = await fetch(`${API}/api/services/`);
      const services = await res.json();
      const icons = { 'code': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>', 'shield': '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>', 'tool': '<path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>', 'cloud': '<path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/>' };
      const grid = document.querySelector('#servicesGrid');
      if (services.length) {
        grid.innerHTML = services.map(s => `
          <div class="service-card">
            <div class="service-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">${icons[s.icon] || icons.code}</svg></div>
            <h3>${s.title}</h3>
            <p>${s.description}</p>
          </div>
        `).join('');
      }
    } catch (e) { console.log('Services API unavailable'); }
  }

  loadHomepage();
  loadFeaturedProjects();
  loadServices();
</script>
