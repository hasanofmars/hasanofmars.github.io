---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillBar from '../components/SkillBar.astro';
import homepage from '../data/homepage.json';
import projects from '../data/projects.json';
import skills from '../data/skills.json';
import services from '../data/services.json';
import profile from '../data/profile.json';

const featuredProjects = projects.filter(p => p.featured);
const homepageSkills = skills.filter(s => s.category === 'Frontend' || s.category === 'Backend');
const securitySkills = skills.filter(s => s.category === 'Security' || s.category === 'DevOps' || s.category === 'Database');

function getIconSvg(icon) {
  const icons = {
    code: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
    shield: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
    tool: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>',
    cloud: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/></svg>',
  };
  return icons[icon] || icons.code;
}
---

<Layout title="Home">
  <Navbar />

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-layout">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span class="badge-text">{homepage.hero_badge}</span>
          </div>
          <h1 class="hero-title">
            {homepage.hero_title.split('M Hasan')[0]}<span class="gradient-text">M Hasan</span>
          </h1>
          <div class="hero-typing">
            <span class="typing-text">{homepage.hero_typing}</span>
          </div>
          <p class="hero-desc">
            {homepage.hero_description}
          </p>
          <div class="hero-actions">
            <a href="/projects" class="btn btn-primary">View Projects</a>
            <a href="/contact" class="btn btn-outline">Contact Me</a>
          </div>
          <div class="hero-stats">
            {homepage.stats.map(stat => (
              <div class="stat-item">
                <span class="stat-number">{stat.number}</span>
                <span class="stat-label">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="hero-avatar-wrapper">
          <div class="hero-avatar-frame">
            <img src={profile.avatar_url} alt={profile.name} class="hero-avatar-img" />
            <div class="hero-avatar-ring"></div>
          </div>
          <div class="hero-avatar-glow"></div>
          <div class="hero-status">
            <span class="status-dot"></span>
            {homepage.hero_status}
          </div>
        </div>
      </div>
    </div>
    <div class="hero-particles">
      <div class="particle" style="top:20%;left:10%;animation-delay:0s"></div>
      <div class="particle" style="top:40%;left:85%;animation-delay:1s"></div>
      <div class="particle" style="top:70%;left:20%;animation-delay:2s"></div>
      <div class="particle" style="top:30%;left:70%;animation-delay:0.5s"></div>
      <div class="particle" style="top:80%;left:75%;animation-delay:1.5s"></div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section featured-section">
    <div class="container">
      <h2 class="section-title">{homepage.featured_title.split('Projects')[0]}<span class="gradient-text">Projects</span></h2>
      <p class="section-subtitle">{homepage.featured_subtitle}</p>
      <div class="projects-grid">
        {featuredProjects.map((p, i) => (
          <ProjectCard
            title={p.title}
            description={p.description}
            techStack={p.tech_stack}
            liveUrl={p.live_url}
            githubUrl={p.github_url}
            category={p.category}
            featured={p.featured}
            index={i}
          />
        ))}
      </div>
      <div class="text-center" style="text-align:center;margin-top:40px;">
        <a href="/projects" class="btn btn-outline">View All Projects →</a>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="section skills-section">
    <div class="container">
      <h2 class="section-title">Technical <span class="gradient-text">Skills</span></h2>
      <p class="section-subtitle">Technologies and expertise I work with</p>
      <div class="skills-grid">
        <div class="skills-col">
          <h3 class="skills-category-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            Development
          </h3>
          {homepageSkills.map((s, i) => (
            <SkillBar name={s.name} level={s.level} category={s.category} index={i} />
          ))}
        </div>
        <div class="skills-col">
          <h3 class="skills-category-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Security & DevOps
          </h3>
          {securitySkills.map((s, i) => (
            <SkillBar name={s.name} level={s.level} category={s.category} index={i} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section services-section">
    <div class="container">
      <h2 class="section-title">{homepage.services_title.split('I')[0]}I <span class="gradient-text">Do</span></h2>
      <p class="section-subtitle">{homepage.services_subtitle}</p>
      <div class="services-grid">
        {services.map((service, i) => (
          <article class="service-card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="service-icon" set:html={getIconSvg(service.icon)}></div>
            <h3 class="service-title">{service.title}</h3>
            <p class="service-desc">{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style is:global>
  /* ===== Hero ===== */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: 70px;
  }

  .hero-layout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
  }

  .hero-content {
    flex: 1;
    max-width: 640px;
    position: relative;
    z-index: 2;
  }

  /* ===== Hero Avatar ===== */
  .hero-avatar-wrapper {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    position: relative;
    z-index: 2;
  }

  .hero-avatar-frame {
    position: relative;
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-avatar-img {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--border-color);
    z-index: 2;
    position: relative;
    transition: var(--transition);
  }

  .hero-avatar-img:hover {
    border-color: var(--accent-green);
    transform: scale(1.02);
  }

  .hero-avatar-ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 2.5px solid transparent;
    background: linear-gradient(135deg, var(--accent-green), var(--accent-cyan), var(--accent-purple)) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: heroSpin 8s linear infinite;
  }

  @keyframes heroSpin {
    to { transform: rotate(360deg); }
  }

  .hero-avatar-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 255, 65, 0.1), transparent 70%);
    filter: blur(20px);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hero-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-green);
    background: rgba(0, 255, 65, 0.08);
    border: 1px solid rgba(0, 255, 65, 0.2);
    padding: 8px 18px;
    border-radius: 50px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-green);
    border-radius: 50%;
    animation: pulse 2s infinite;
    box-shadow: 0 0 8px var(--accent-green);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 255, 65, 0.1);
    border: 1px solid rgba(0, 255, 65, 0.2);
    padding: 8px 16px;
    border-radius: 50px;
    margin-bottom: 30px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-green);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-green);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .hero-title {
    font-size: 4.5rem;
    font-weight: 800;
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .hero-typing {
    margin-bottom: 24px;
  }

  .typing-text {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--text-secondary);
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid var(--accent-green);
    animation: typing 3s steps(40) 1s 1 normal both, blink 0.8s step-end infinite;
    max-width: fit-content;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 36px;
    max-width: 600px;
  }

  .hero-desc strong {
    color: var(--accent-green);
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 60px;
  }

  .hero-stats {
    display: flex;
    gap: 50px;
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-family: var(--font-mono);
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--accent-green);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent-green), 0 0 12px var(--accent-green);
    animation: float 6s ease-in-out infinite;
    opacity: 0.5;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); opacity: 0.5; }
    50% { transform: translateY(-30px) scale(1.5); opacity: 1; }
  }

  /* ===== Featured Projects ===== */
  .featured-section {
    background: var(--bg-secondary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
  }

  .featured-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 32px;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
  }

  .featured-card:hover {
    border-color: var(--accent-green);
    transform: translateY(-4px);
    box-shadow: var(--shadow-green);
  }

  .fc-icon {
    width: 48px;
    height: 48px;
    background: rgba(0, 255, 65, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: var(--accent-green);
  }

  .fc-icon svg,
  .service-icon svg {
    width: 24px;
    height: 24px;
  }

  .featured-card h3 {
    font-size: 1.2rem;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .featured-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .fc-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .fc-tech span {
    background: rgba(0, 212, 255, 0.08);
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 3px 10px;
    border-radius: 4px;
    border: 1px solid rgba(0, 212, 255, 0.15);
  }

  .fc-actions {
    display: flex;
    gap: 10px;
  }

  /* ===== Skills Section ===== */
  .skills-section {
    background: var(--bg-secondary);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .skills-col {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 20px;
  }

  .skills-category-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-cyan);
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border-color);
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .skills-category-title svg {
    width: 16px;
    height: 16px;
  }

  .skill-category-group h3 {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent-cyan);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-color);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .skill-bar-item {
    margin-bottom: 14px;
  }

  .skill-bar-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .skill-bar-name {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .skill-bar-value {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-green);
  }

  .skill-bar-track {
    width: 100%;
    height: 6px;
    background: var(--bg-primary);
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--border-color);
  }

  .skill-bar-fill {
    height: 100%;
    background: var(--gradient-main);
    border-radius: 3px;
    transition: width 1s ease;
    width: 0;
  }

  .skill-bar-fill.animated {
    animation: skillGrow 1.5s ease forwards;
  }

  @keyframes skillGrow {
    from { width: 0; }
  }

  /* ===== Services ===== */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .service-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 28px;
    transition: var(--transition);
    text-align: center;
  }

  .service-card:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .service-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    background: rgba(0, 212, 255, 0.1);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
  }

  .service-icon svg {
    width: 28px;
    height: 28px;
  }

  .service-card h3 {
    font-size: 1.1rem;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .service-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1024px) {
    .hero-layout {
      flex-direction: column-reverse;
      text-align: center;
      gap: 40px;
    }
    .hero-content {
      max-width: 100%;
    }
    .hero-badge {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-desc {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-stats {
      justify-content: center;
    }
    .hero-avatar-frame {
      width: 200px;
      height: 200px;
    }
    .hero-avatar-img {
      width: 184px;
      height: 184px;
    }
    .hero-avatar-glow {
      width: 220px;
      height: 220px;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.8rem;
    }
    .typing-text {
      font-size: 1rem;
      white-space: normal;
      border-right: none;
      animation: none;
    }
    .hero-layout {
      gap: 30px;
    }
    .hero-avatar-frame {
      width: 160px;
      height: 160px;
    }
    .hero-avatar-img {
      width: 148px;
      height: 148px;
    }
    .hero-avatar-glow {
      width: 180px;
      height: 180px;
    }
    .hero-stats {
      gap: 30px;
    }
    .stat-number {
      font-size: 1.5rem;
    }
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .services-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .service-card {
      padding: 20px;
    }
    .section {
      padding: 50px 0;
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: auto;
      padding: 100px 0 60px;
    }
    .hero-title {
      font-size: 2rem;
    }
    .hero-badge {
      font-size: 0.75rem;
      padding: 6px 12px;
      margin-bottom: 20px;
    }
    .hero-desc {
      font-size: 0.95rem;
      margin-bottom: 24px;
    }
    .hero-stats {
      flex-direction: row;
      gap: 16px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .stat-item {
      min-width: 80px;
    }
    .stat-number {
      font-size: 1.3rem;
    }
    .stat-label {
      font-size: 0.7rem;
    }
    .hero-actions {
      margin-bottom: 30px;
    }
    .hero-avatar-frame {
      width: 130px;
      height: 130px;
    }
    .hero-avatar-img {
      width: 120px;
      height: 120px;
    }
    .hero-avatar-glow {
      width: 150px;
      height: 150px;
    }
    .hero-avatar-ring {
      inset: -6px;
    }
    .hero-status {
      font-size: 0.7rem;
      padding: 6px 14px;
    }
    .section-title {
      font-size: 1.5rem;
    }
    .section-subtitle {
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
    }
    .projects-grid {
      gap: 16px;
    }
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .skills-col {
      padding: 14px;
    }
    .services-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .service-card {
      padding: 16px;
    }
    .service-icon {
      width: 44px;
      height: 44px;
      margin-bottom: 14px;
    }
    .service-icon svg {
      width: 22px;
      height: 22px;
    }
    .service-card h3 {
      font-size: 0.95rem;
    }
    .service-card p {
      font-size: 0.8rem;
    }
    .hero-particles {
      display: none;
    }
  }
</style>
