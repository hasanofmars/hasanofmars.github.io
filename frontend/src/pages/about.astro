---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SkillBar from '../components/SkillBar.astro';
import skills from '../data/skills.json';
import profile from '../data/profile.json';
---

<Layout
  title="About"
  description="Learn about M Hasan — Full Stack Developer and Cybersecurity Expert with 5+ years of experience in secure web development, penetration testing, and digital forensics."
  canonical="https://hasanofmars.github.io/about/"
>
  <Navbar />

  <section class="page-header">
    <div class="container">
      <h1 class="page-title">About <span class="gradient-text">Me</span></h1>
      <p class="page-desc">Get to know my background, skills, and passion for cybersecurity</p>
    </div>
  </section>

  <!-- Bio Section -->
  <section class="section bio-section">
    <div class="container">
      <div class="bio-grid">
        <div class="bio-image-wrapper">
          <div class="bio-image-placeholder">
            <div class="avatar-frame">
              <img src={profile.avatar_url} alt="M Hasan - Full Stack Developer and Cybersecurity Expert" class="avatar-img" width="200" height="200" />
              <div class="avatar-ring"></div>
            </div>
          </div>
          <div class="bio-contact">
            <div class="contact-chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {profile.location}
            </div>
            <div class="contact-chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              {profile.email}
            </div>
          </div>
        </div>
        <div class="bio-content">
          <h2>Cybersecurity Expert & <span class="gradient-text">Full Stack Developer</span></h2>
          <p>
            I'm <strong>M Hasan</strong>, a passionate Full Stack Developer and Cybersecurity Expert based in <strong>Dhaka, Bangladesh</strong>.
            With over 5 years of experience in the field, I specialize in building secure, scalable web applications
            and protecting digital infrastructure from emerging threats.
          </p>
          <p>
            My journey began with a curiosity about how things work on the internet, which led me to dive deep
            into both web development and cybersecurity. I believe that security should never be an afterthought —
            it should be integrated into every layer of application development.
          </p>
          <p>
            When I'm not coding or conducting security audits, I contribute to open-source security tools,
            write about <a href="/blog/">cybersecurity best practices</a>, and mentor aspiring developers in the Bangladeshi tech community.
          </p>
          <div class="bio-stats-row">
            <div class="bio-stat">
              <span class="bio-stat-num">5+</span>
              <span class="bio-stat-label">Years Exp.</span>
            </div>
            <div class="bio-stat">
              <span class="bio-stat-num">50+</span>
              <span class="bio-stat-label">Projects</span>
            </div>
            <div class="bio-stat">
              <span class="bio-stat-num">100+</span>
              <span class="bio-stat-label">Clients</span>
            </div>
            <div class="bio-stat">
              <span class="bio-stat-num">30+</span>
              <span class="bio-stat-label">CVE Reports</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="section skills-section">
    <div class="container">
      <h2 class="section-title">Technical <span class="gradient-text">Skills</span></h2>
      <p class="section-subtitle">Proficient in a wide range of technologies and security tools</p>
      <div class="skills-grid">
        <div class="skills-col">
          <h3 class="skills-category-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            Development
          </h3>
          {skills.filter(s => s.category === 'Frontend' || s.category === 'Backend').map((s, i) => (
            <SkillBar name={s.name} level={s.level} category={s.category} index={i} />
          ))}
        </div>
        <div class="skills-col">
          <h3 class="skills-category-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Security & DevOps
          </h3>
          {skills.filter(s => s.category === 'Security' || s.category === 'DevOps' || s.category === 'Database').map((s, i) => (
            <SkillBar name={s.name} level={s.level} category={s.category} index={i} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="section cert-section">
    <div class="container">
      <h2 class="section-title">Certifications & <span class="gradient-text">Achievements</span></h2>
      <p class="section-subtitle">Professional credentials and notable accomplishments</p>
      <div class="cert-grid">
        <div class="cert-card">
          <div class="cert-badge">CEH</div>
          <h3>Certified Ethical Hacker</h3>
          <p>EC-Council</p>
        </div>
        <div class="cert-card">
          <div class="cert-badge">OSCP</div>
          <h3>Offensive Security Certified</h3>
          <p>Offensive Security</p>
        </div>
        <div class="cert-card">
          <div class="cert-badge">CISSP</div>
          <h3>Certified Information Systems Security</h3>
          <p>ISC²</p>
        </div>
        <div class="cert-card">
          <div class="cert-badge">AWS</div>
          <h3>AWS Certified Security</h3>
          <p>Amazon Web Services</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ===== Page Header ===== */
  .page-header {
    padding: 160px 0 60px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .page-title {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .page-desc {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 500px;
  }

  /* ===== Bio Section ===== */
  .bio-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 60px;
    align-items: start;
  }

  .bio-image-placeholder {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
  }

  .avatar-frame {
    position: relative;
    width: 220px;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-img {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-color);
    z-index: 2;
    position: relative;
  }

  .avatar-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid transparent;
    background: linear-gradient(135deg, var(--accent-green), var(--accent-cyan)) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: spin 8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .bio-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
  }

  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 10px 18px;
    border-radius: 50px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .contact-chip svg {
    width: 16px;
    height: 16px;
    color: var(--accent-green);
  }

  .bio-content h2 {
    font-size: 2rem;
    margin-bottom: 24px;
  }

  .bio-content p {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 16px;
    font-size: 1.05rem;
  }

  .bio-content strong {
    color: var(--accent-green);
  }

  .bio-stats-row {
    display: flex;
    gap: 30px;
    margin-top: 30px;
    padding-top: 30px;
    border-top: 1px solid var(--border-color);
  }

  .bio-stat {
    text-align: center;
  }

  .bio-stat-num {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: var(--font-mono);
  }

  .bio-stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  /* ===== Skills ===== */
  .skills-section {
    background: var(--bg-secondary);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .skills-col {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 20px;
  }

  .skills-category-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--accent-cyan);
    margin-bottom: 14px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border-color);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .skills-category-title svg {
    width: 16px;
    height: 16px;
    color: var(--accent-green);
  }

  /* ===== Certifications ===== */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .cert-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 28px;
    text-align: center;
    transition: var(--transition);
  }

  .cert-card:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-3px);
  }

  .cert-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bg-primary);
    background: var(--gradient-main);
    padding: 4px 14px;
    border-radius: 4px;
    margin-bottom: 16px;
  }

  .cert-card h3 {
    font-size: 1rem;
    margin-bottom: 8px;
  }

  .cert-card p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 1024px) {
    .bio-grid { gap: 40px; }
    .page-header { padding: 140px 0 50px; }
  }

  @media (max-width: 768px) {
    .bio-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .page-title {
      font-size: 2.2rem;
    }
    .page-desc {
      font-size: 0.95rem;
      max-width: 100%;
    }
    .bio-stats-row {
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }
    .bio-content h2 {
      font-size: 1.6rem;
    }
    .bio-content p {
      font-size: 0.95rem;
    }
    .page-header {
      padding: 120px 0 40px;
    }
    .cert-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .page-header {
      padding: 100px 0 28px;
    }
    .page-title {
      font-size: 1.8rem;
    }
    .avatar-frame {
      width: 160px;
      height: 160px;
    }
    .avatar-img {
      width: 145px;
      height: 145px;
    }
    .avatar-ring {
      inset: -6px;
    }
    .contact-chip {
      font-size: 0.8rem;
      padding: 8px 14px;
    }
    .bio-content h2 {
      font-size: 1.3rem;
    }
    .bio-content p {
      font-size: 0.9rem;
    }
    .bio-stats-row {
      gap: 14px;
    }
    .bio-stat-num {
      font-size: 1.2rem;
    }
    .bio-stat-label {
      font-size: 0.7rem;
    }
    .skills-col {
      padding: 14px;
    }
    .cert-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .cert-card {
      padding: 20px;
    }
    .cert-card h3 {
      font-size: 0.9rem;
    }
  }
</style>
