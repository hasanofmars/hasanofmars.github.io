---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import profile from '../data/profile.json';
import contact from '../data/contact.json';
---

<Layout
  title="Contact"
  description="Get in touch with M Hasan for cybersecurity consulting, secure web development, penetration testing, or project collaboration."
  canonical="https://hasanofmars.github.io/contact/"
>
  <Navbar />

  <section class="page-header">
    <div class="container">
      <h1 class="page-title">Get In <span class="gradient-text">Touch</span></h1>
      <p class="page-desc">Have a project in mind or need security consulting? Let's talk.</p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <h2>{contact.heading.split(' secure')[0]} <span class="gradient-text">secure</span></h2>
          <p>{contact.description}</p>

          <div class="contact-details">
            <div class="contact-item">
              <div class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <h4>Email</h4>
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              </div>
            </div>
            <div class="contact-item">
              <div class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h4>Location</h4>
                <p>{profile.location}</p>
              </div>
            </div>
            <div class="contact-item">
              <div class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>
              </div>
              <div>
                <h4>GitHub</h4>
                <a href={contact.social.github} target="_blank" rel="noopener">{contact.social.github.replace('https://', '')}</a>
              </div>
            </div>
          </div>

          <div class="availability">
            <div class="avail-dot"></div>
            <span>{contact.availability}</span>
          </div>
        </div>

        <div class="contact-form-wrapper">
          <form class="contact-form" id="contactForm">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Your Name</label>
                <input type="text" id="name" placeholder="John Doe" required />
              </div>
              <div class="form-group">
                <label for="email">Your Email</label>
                <input type="email" id="email" placeholder="john@example.com" required />
              </div>
            </div>
            <div class="form-group">
              <label for="subject">Subject</label>
              <input type="text" id="subject" placeholder="Project Collaboration" />
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" rows="6" placeholder="Tell me about your project..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">
              Send Message
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-header {
    padding: 160px 0 60px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .page-title { font-size: 3rem; margin-bottom: 12px; }
  .page-desc { color: var(--text-secondary); font-size: 1.1rem; max-width: 500px; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .contact-info h2 {
    font-size: 2rem;
    margin-bottom: 20px;
  }

  .contact-info > p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 36px;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 30px;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .contact-icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: rgba(0, 255, 65, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-green);
  }

  .contact-icon svg {
    width: 20px;
    height: 20px;
  }

  .contact-item h4 {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 4px;
    font-family: var(--font-mono);
  }

  .contact-item a, .contact-item p {
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 255, 65, 0.08);
    border: 1px solid rgba(0, 255, 65, 0.2);
    padding: 14px 20px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-green);
  }

  .avail-dot {
    width: 10px;
    height: 10px;
    background: var(--accent-green);
    border-radius: 50%;
    animation: pulse 2s infinite;
    box-shadow: 0 0 8px var(--accent-green);
  }

  .contact-form-wrapper {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 40px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  @media (max-width: 1024px) {
    .contact-grid { gap: 40px; }
    .page-header { padding: 140px 0 50px; }
  }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; gap: 36px; }
    .form-row { grid-template-columns: 1fr; }
    .page-title { font-size: 2.2rem; }
    .page-desc { font-size: 0.95rem; max-width: 100%; }
    .contact-form-wrapper { padding: 24px; }
    .page-header { padding: 120px 0 40px; }
    .contact-info h2 { font-size: 1.6rem; }
    .contact-details { gap: 18px; }
  }

  @media (max-width: 480px) {
    .page-header { padding: 100px 0 28px; }
    .page-title { font-size: 1.8rem; }
    .contact-form-wrapper { padding: 16px; border-radius: var(--radius-md); }
    .contact-item { flex-direction: column; align-items: center; text-align: center; gap: 10px; }
    .contact-icon { width: 36px; height: 36px; min-width: 36px; }
    .contact-icon svg { width: 16px; height: 16px; }
    .contact-info h2 { font-size: 1.3rem; margin-bottom: 14px; }
    .contact-info > p { font-size: 0.9rem; margin-bottom: 24px; }
    .contact-details { gap: 14px; }
    .availability { font-size: 0.75rem; padding: 10px 14px; flex-wrap: wrap; justify-content: center; }
    .form-group { margin-bottom: 14px; }
    input, textarea { padding: 10px 14px; font-size: 0.9rem; }
  }
</style>

<script>
  document.getElementById('contactForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Thank you for your message! I will get back to you soon.');
    e.target.reset();
  });
</script>
