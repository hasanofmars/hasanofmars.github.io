---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Homepage">
  <div class="dash-header">
    <h1>Homepage <span class="gradient-text">Settings</span></h1>
    <p>Edit hero section, stats, titles</p>
  </div>

  <div class="form-card">
    <form id="homepageForm" class="dash-form">
      <h2 class="form-section-title">Hero Section</h2>
      <div class="form-row">
        <div class="form-group">
          <label for="hero_badge">Badge Text</label>
          <input type="text" id="hero_badge" placeholder="Cybersecurity Expert & Developer" />
        </div>
        <div class="form-group">
          <label for="hero_title">Hero Title</label>
          <input type="text" id="hero_title" placeholder="Hi, I'm M Hasan" />
        </div>
      </div>
      <div class="form-group">
        <label for="hero_typing">Typing Text</label>
        <input type="text" id="hero_typing" placeholder="I build secure & scalable web solutions" />
      </div>
      <div class="form-group">
        <label for="hero_description">Description</label>
        <textarea id="hero_description" rows="3" placeholder="Full Stack Developer..."></textarea>
      </div>
      <div class="form-group">
        <label for="hero_status">Status Text</label>
        <input type="text" id="hero_status" placeholder="Available for projects" />
      </div>

      <h2 class="form-section-title">Stats</h2>
      <div id="statsContainer">
        <div class="stats-row">
          <input type="text" class="stat-number-input" placeholder="5+" />
          <input type="text" class="stat-label-input" placeholder="Years Experience" />
          <button type="button" class="btn-remove" onclick="this.parentElement.remove()">✕</button>
        </div>
      </div>
      <button type="button" class="btn btn-outline btn-small" id="addStatBtn" style="margin-bottom:24px;">+ Add Stat</button>

      <h2 class="form-section-title">Section Titles</h2>
      <div class="form-row">
        <div class="form-group">
          <label for="featured_title">Featured Title</label>
          <input type="text" id="featured_title" placeholder="Featured Projects" />
        </div>
        <div class="form-group">
          <label for="featured_subtitle">Featured Subtitle</label>
          <input type="text" id="featured_subtitle" placeholder="Highlighting..." />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="services_title">Services Title</label>
          <input type="text" id="services_title" placeholder="What I Do" />
        </div>
        <div class="form-group">
          <label for="services_subtitle">Services Subtitle</label>
          <input type="text" id="services_subtitle" placeholder="Comprehensive..." />
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</DashboardLayout>

<style>
  .dash-header { margin-bottom: 28px; }
  .dash-header h1 { font-size: 2rem; margin-bottom: 8px; }
  .dash-header p { color: var(--text-secondary); font-family: var(--font-mono); font-size: 0.9rem; }
  .form-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 28px; }
  .form-section-title { font-size: 1.1rem; color: var(--accent-green); font-family: var(--font-mono); margin: 24px 0 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border-color); }
  .form-section-title:first-of-type { margin-top: 0; }
  .dash-form .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .dash-form .form-group { margin-bottom: 16px; }
  .form-actions { margin-top: 8px; }
  .stats-row { display: flex; gap: 10px; align-items: center; margin-bottom: 10px; }
  .stats-row input { flex: 1; }
  .btn-remove { width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border-color); background: rgba(255,71,87,0.1); color: var(--accent-red); cursor: pointer; font-size: 0.9rem; flex-shrink: 0; }
  .btn-remove:hover { background: rgba(255,71,87,0.2); }
  @media (max-width: 768px) { .dash-form .form-row { grid-template-columns: 1fr; } }
</style>

<script>
  const API = window.API_BASE || 'http://localhost:8000';
  const token = localStorage.getItem('token');
  const headers = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };

  async function loadData() {
    try {
      const res = await fetch(`${API}/api/homepage/`);
      const data = await res.json();
      document.getElementById('hero_badge').value = data.hero_badge || '';
      document.getElementById('hero_title').value = data.hero_title || '';
      document.getElementById('hero_typing').value = data.hero_typing || '';
      document.getElementById('hero_description').value = data.hero_description || '';
      document.getElementById('hero_status').value = data.hero_status || '';
      document.getElementById('featured_title').value = data.featured_title || '';
      document.getElementById('featured_subtitle').value = data.featured_subtitle || '';
      document.getElementById('services_title').value = data.services_title || '';
      document.getElementById('services_subtitle').value = data.services_subtitle || '';

      const container = document.getElementById('statsContainer');
      container.innerHTML = '';
      (data.stats || [{number:'5+',label:'Years Experience'},{number:'50+',label:'Projects Done'},{number:'100+',label:'Happy Clients'}]).forEach(s => {
        const div = document.createElement('div');
        div.className = 'stats-row';
        div.innerHTML = `<input type="text" class="stat-number-input" value="${s.number}" placeholder="Number" /><input type="text" class="stat-label-input" value="${s.label}" placeholder="Label" /><button type="button" class="btn-remove" onclick="this.parentElement.remove()">✕</button>`;
        container.appendChild(div);
      });
    } catch { console.log('Could not load homepage data'); }
  }

  document.getElementById('addStatBtn').addEventListener('click', () => {
    const container = document.getElementById('statsContainer');
    const div = document.createElement('div');
    div.className = 'stats-row';
    div.innerHTML = '<input type="text" class="stat-number-input" placeholder="Number" /><input type="text" class="stat-label-input" placeholder="Label" /><button type="button" class="btn-remove" onclick="this.parentElement.remove()">✕</button>';
    container.appendChild(div);
  });

  document.getElementById('homepageForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const statRows = document.querySelectorAll('#statsContainer .stats-row');
    const stats = Array.from(statRows).map(row => ({
      number: row.querySelector('.stat-number-input').value,
      label: row.querySelector('.stat-label-input').value,
    }));

    const payload = {
      hero_badge: document.getElementById('hero_badge').value,
      hero_title: document.getElementById('hero_title').value,
      hero_typing: document.getElementById('hero_typing').value,
      hero_description: document.getElementById('hero_description').value,
      hero_status: document.getElementById('hero_status').value,
      featured_title: document.getElementById('featured_title').value,
      featured_subtitle: document.getElementById('featured_subtitle').value,
      services_title: document.getElementById('services_title').value,
      services_subtitle: document.getElementById('services_subtitle').value,
      stats,
    };

    try {
      const res = await fetch(`${API}/api/homepage/`, { method: 'PUT', headers, body: JSON.stringify(payload) });
      if (res.ok) alert('✅ Homepage updated successfully!');
      else { const err = await res.json(); alert('Error: ' + (err.detail || 'Unknown')); }
    } catch { alert('Cannot connect to server'); }
  });

  loadData();
</script>
