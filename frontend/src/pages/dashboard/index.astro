---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Overview">
  <div class="dash-header">
    <h1>Dashboard <span class="gradient-text">Overview</span></h1>
    <p>Welcome back, M Hasan</p>
  </div>

  <!-- Stats Cards -->
  <div class="stats-grid" id="statsGrid">
    <div class="stat-card">
      <div class="stat-icon stat-icon-projects">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
      </div>
      <div class="stat-info">
        <span class="stat-value" id="totalProjects">0</span>
        <span class="stat-label">Total Projects</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-skills">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
      </div>
      <div class="stat-info">
        <span class="stat-value" id="totalSkills">0</span>
        <span class="stat-label">Skills</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-featured">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </div>
      <div class="stat-info">
        <span class="stat-value" id="featuredProjects">0</span>
        <span class="stat-label">Featured</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-security">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div class="stat-info">
        <span class="stat-value" id="securityTools">0</span>
        <span class="stat-label">Security Tools</span>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="quick-actions">
    <h2 class="section-label">Quick Actions</h2>
    <div class="actions-grid">
      <a href="/dashboard/projects" class="action-card">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add Project</span>
      </a>
      <a href="/dashboard/settings" class="action-card">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Edit Profile</span>
      </a>
      <a href="/" class="action-card">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span>View Site</span>
      </a>
    </div>
  </div>

  <!-- Recent Activity / Info -->
  <div class="dash-info">
    <h2 class="section-label">System Info</h2>
    <div class="info-card">
      <div class="info-row">
        <span class="info-key">API Status</span>
        <span class="info-value" id="apiStatus">Checking...</span>
      </div>
      <div class="info-row">
        <span class="info-key">Backend</span>
        <span class="info-value">FastAPI + SQLite</span>
      </div>
      <div class="info-row">
        <span class="info-key">Frontend</span>
        <span class="info-value">Astro.js</span>
      </div>
      <div class="info-row">
        <span class="info-key">Auth</span>
        <span class="info-value" id="authStatus">JWT</span>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .dash-header {
    margin-bottom: 32px;
  }

  .dash-header h1 {
    font-size: 2rem;
    margin-bottom: 8px;
  }

  .dash-header p {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 36px;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: var(--transition);
  }

  .stat-card:hover {
    border-color: var(--accent-green);
    transform: translateY(-2px);
    box-shadow: var(--shadow-green);
  }

  .stat-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stat-icon svg {
    width: 26px;
    height: 26px;
  }

  .stat-icon-projects {
    background: rgba(0, 255, 65, 0.1);
    color: var(--accent-green);
  }

  .stat-icon-skills {
    background: rgba(0, 212, 255, 0.1);
    color: var(--accent-cyan);
  }

  .stat-icon-featured {
    background: rgba(255, 215, 0, 0.1);
    color: var(--accent-yellow);
  }

  .stat-icon-security {
    background: rgba(139, 92, 246, 0.1);
    color: var(--accent-purple);
  }

  .stat-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .section-label {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-bottom: 16px;
    font-family: var(--font-mono);
  }

  .actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
    margin-bottom: 36px;
  }

  .action-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 24px 16px;
    text-decoration: none;
    color: var(--text-secondary);
    transition: var(--transition);
    cursor: pointer;
  }

  .action-card:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    transform: translateY(-2px);
  }

  .action-card svg {
    width: 28px;
    height: 28px;
  }

  .action-card span {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .dash-info {
    margin-bottom: 36px;
  }

  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 24px;
    border-bottom: 1px solid var(--border-color);
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-key {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .info-value {
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
</style>

<script>
  // Fetch stats from API
  async function loadStats() {
    const token = localStorage.getItem('token');
    const headers = { Authorization: `Bearer ${token}` };

    try {
      const res = await fetch((window.API_BASE || 'http://localhost:8000') + '/api/profile/stats', { headers });
      if (res.ok) {
        const data = await res.json();
        document.getElementById('totalProjects').textContent = data.total_projects ?? 0;
        document.getElementById('totalSkills').textContent = data.total_skills ?? 0;
        document.getElementById('featuredProjects').textContent = data.featured_projects ?? 0;
        document.getElementById('securityTools').textContent = data.security_tools ?? 0;
      }
    } catch (e) {
      console.log('Stats API not available');
    }

    // Check API health
    try {
      const healthRes = await fetch((window.API_BASE || 'http://localhost:8000') + '/api/health');
      if (healthRes.ok) {
        document.getElementById('apiStatus').textContent = '🟢 Online';
        document.getElementById('apiStatus').style.color = 'var(--accent-green)';
      } else {
        document.getElementById('apiStatus').textContent = '🔴 Error';
        document.getElementById('apiStatus').style.color = 'var(--accent-red)';
      }
    } catch {
      document.getElementById('apiStatus').textContent = '🔴 Offline';
      document.getElementById('apiStatus').style.color = 'var(--accent-red)';
    }
  }

  loadStats();
</script>
