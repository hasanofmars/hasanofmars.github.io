---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Manage Projects">
  <div class="dash-header">
    <h1>Manage <span class="gradient-text">Projects</span></h1>
    <p>Add, edit, or remove portfolio projects</p>
  </div>

  <!-- Add Project Form -->
  <div class="form-card">
    <div class="form-card-header" id="formHeader">
      <h2 id="formTitle">Add New Project</h2>
    </div>
    <form id="projectForm" class="dash-form">
      <input type="hidden" id="editId" value="" />
      <div class="form-row">
        <div class="form-group">
          <label for="title">Project Title *</label>
          <input type="text" id="title" placeholder="e.g., NetShield Pro" required />
        </div>
        <div class="form-group">
          <label for="category">Category</label>
          <select id="category">
            <option value="Cybersecurity">Cybersecurity</option>
            <option value="Security">Security</option>
            <option value="Security Tool">Security Tool</option>
            <option value="Web App">Web App</option>
            <option value="DevOps">DevOps</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" rows="3" placeholder="Brief description of the project"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="techStack">Tech Stack (comma separated)</label>
          <input type="text" id="techStack" placeholder="e.g., Python, React, Docker" />
        </div>
        <div class="form-group">
          <label for="featured">
            <input type="checkbox" id="featured" style="width:auto;margin-right:8px;" />
            Featured Project
          </label>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="liveUrl">Live URL</label>
          <input type="url" id="liveUrl" placeholder="https://..." />
        </div>
        <div class="form-group">
          <label for="githubUrl">GitHub URL</label>
          <input type="url" id="githubUrl" placeholder="https://github.com/..." />
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="submitBtn">Add Project</button>
        <button type="button" class="btn btn-outline" id="cancelBtn" style="display:none;">Cancel</button>
      </div>
    </form>
  </div>

  <!-- Projects List -->
  <div class="dash-table-wrapper">
    <h2 class="section-label">All Projects</h2>
    <div class="dash-table-container">
      <table class="dash-table" id="projectsTable">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Featured</th>
            <th>Tech Stack</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="projectsBody">
          <tr>
            <td colspan="5" style="text-align:center;color:var(--text-muted);padding:40px;">
              Loading projects...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>

<style>
  .dash-header {
    margin-bottom: 28px;
  }
  .dash-header h1 { font-size: 2rem; margin-bottom: 8px; }
  .dash-header p { color: var(--text-secondary); font-family: var(--font-mono); font-size: 0.9rem; }

  .form-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 28px;
    margin-bottom: 36px;
  }

  .form-card-header {
    margin-bottom: 24px;
  }

  .form-card-header h2 {
    font-size: 1.2rem;
  }

  .dash-form .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .dash-form .form-group {
    margin-bottom: 16px;
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .section-label {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-bottom: 16px;
    font-family: var(--font-mono);
  }

  .dash-table-container {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow-x: auto;
  }

  .dash-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .dash-table th {
    padding: 14px 20px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
  }

  .dash-table td {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  .dash-table tr:last-child td {
    border-bottom: none;
  }

  .dash-table tr:hover td {
    background: rgba(0, 255, 65, 0.02);
  }

  .badge-featured {
    display: inline-block;
    background: rgba(0, 255, 65, 0.1);
    color: var(--accent-green);
    font-size: 0.7rem;
    padding: 3px 10px;
    border-radius: 20px;
    font-family: var(--font-mono);
  }

  .badge-not-featured {
    display: inline-block;
    background: rgba(100, 116, 139, 0.1);
    color: var(--text-muted);
    font-size: 0.7rem;
    padding: 3px 10px;
    border-radius: 20px;
    font-family: var(--font-mono);
  }

  .table-actions {
    display: flex;
    gap: 8px;
  }

  .table-actions button {
    padding: 6px 14px;
    font-size: 0.75rem;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    font-weight: 600;
    transition: var(--transition);
    font-family: var(--font-mono);
  }

  .btn-edit {
    background: rgba(0, 212, 255, 0.1);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 212, 255, 0.2) !important;
  }

  .btn-edit:hover {
    background: rgba(0, 212, 255, 0.2);
  }

  .btn-delete {
    background: rgba(255, 71, 87, 0.1);
    color: var(--accent-red);
    border: 1px solid rgba(255, 71, 87, 0.2) !important;
  }

  .btn-delete:hover {
    background: rgba(255, 71, 87, 0.2);
  }

  @media (max-width: 768px) {
    .dash-form .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const API = window.API_BASE || 'http://localhost:8000';
  const token = localStorage.getItem('token');
  const headers = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };

  const form = document.getElementById('projectForm');
  const submitBtn = document.getElementById('submitBtn');
  const cancelBtn = document.getElementById('cancelBtn');
  const formTitle = document.getElementById('formTitle');
  const editId = document.getElementById('editId');
  const tbody = document.getElementById('projectsBody');

  // Load projects
  async function loadProjects() {
    try {
      const res = await fetch(`${API}/api/projects/`, { headers: { Authorization: `Bearer ${token}` } });
      const data = await res.json();
      if (!Array.isArray(data)) throw new Error('Invalid data');
      renderProjects(data);
    } catch {
      // Try without auth
      const res = await fetch(`${API}/api/projects/`);
      const data = await res.json();
      if (Array.isArray(data)) renderProjects(data);
    }
  }

  function renderProjects(projects) {
    if (projects.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:40px;">No projects yet. Add your first project!</td></tr>`;
      return;
    }
    tbody.innerHTML = projects.map(p => `
      <tr>
        <td><strong>${p.title}</strong></td>
        <td>${p.category || '—'}</td>
        <td>${p.featured ? '<span class="badge-featured">✦ Featured</span>' : '<span class="badge-not-featured">No</span>'}</td>
        <td style="font-size:0.8rem;color:var(--text-secondary);">${p.tech_stack || '—'}</td>
        <td>
          <div class="table-actions">
            <button class="btn-edit" onclick="editProject(${p.id}, '${p.title.replace(/'/g, "\\'")}', '${(p.description || '').replace(/'/g, "\\'")}', '${(p.tech_stack || '').replace(/'/g, "\\'")}', '${(p.category || '').replace(/'/g, "\\'")}', ${p.featured}, '${(p.live_url || '').replace(/'/g, "\\'")}', '${(p.github_url || '').replace(/'/g, "\\'")}')">Edit</button>
            <button class="btn-delete" onclick="deleteProject(${p.id})">Delete</button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  // Edit project
  window.editProject = function(id, title, desc, techStack, category, featured, liveUrl, githubUrl) {
    editId.value = id;
    document.getElementById('title').value = title;
    document.getElementById('description').value = desc;
    document.getElementById('techStack').value = techStack;
    document.getElementById('category').value = category;
    document.getElementById('featured').checked = featured;
    document.getElementById('liveUrl').value = liveUrl;
    document.getElementById('githubUrl').value = githubUrl;
    formTitle.textContent = 'Edit Project';
    submitBtn.textContent = 'Update Project';
    cancelBtn.style.display = 'inline-flex';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // Cancel edit
  cancelBtn.addEventListener('click', resetForm);

  function resetForm() {
    form.reset();
    editId.value = '';
    formTitle.textContent = 'Add New Project';
    submitBtn.textContent = 'Add Project';
    cancelBtn.style.display = 'none';
  }

  // Delete project
  window.deleteProject = async function(id) {
    if (!confirm('Are you sure you want to delete this project?')) return;
    try {
      const res = await fetch(`${API}/api/projects/${id}`, {
        method: 'DELETE',
        headers,
      });
      if (res.ok) {
        loadProjects();
      } else {
        alert('Failed to delete project');
      }
    } catch {
      alert('Server not available');
    }
  };

  // Submit form
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const isEdit = editId.value !== '';
    const payload = {
      title: document.getElementById('title').value,
      description: document.getElementById('description').value,
      tech_stack: document.getElementById('techStack').value,
      category: document.getElementById('category').value,
      featured: document.getElementById('featured').checked,
      live_url: document.getElementById('liveUrl').value,
      github_url: document.getElementById('githubUrl').value,
    };

    try {
      const url = isEdit ? `${API}/api/projects/${editId.value}` : `${API}/api/projects/`;
      const method = isEdit ? 'PUT' : 'POST';
      const res = await fetch(url, { method, headers, body: JSON.stringify(payload) });
      if (res.ok) {
        resetForm();
        loadProjects();
      } else {
        const err = await res.json();
        alert('Error: ' + (err.detail || 'Unknown error'));
      }
    } catch {
      alert('Cannot connect to server. Make sure the backend is running.');
    }
  });

  loadProjects();
</script>
