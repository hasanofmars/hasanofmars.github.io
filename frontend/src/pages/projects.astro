---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
---

<Layout title="Projects">
  <Navbar />

  <section class="page-header">
    <div class="container">
      <h1 class="page-title">My <span class="gradient-text">Projects</span></h1>
      <p class="page-desc">A collection of security tools, web applications, and open-source contributions</p>
    </div>
  </section>

  <!-- Filter Tabs -->
  <section class="section projects-section">
    <div class="container">
      <div class="filter-tabs" id="filterTabs">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="Cybersecurity">Cybersecurity</button>
        <button class="filter-btn" data-filter="Security">Security</button>
        <button class="filter-btn" data-filter="Web App">Web Apps</button>
        <button class="filter-btn" data-filter="DevOps">DevOps</button>
      </div>

      <div class="projects-grid" id="projectsGrid">
        {projects.map((p, i) => (
          <div class="project-wrapper" data-category={p.category}>
            <ProjectCard
              title={p.title}
              description={p.description}
              techStack={p.tech_stack}
              liveUrl={p.live_url}
              githubUrl={p.github_url}
              category={p.category}
              featured={p.featured}
              index={i}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-header {
    padding: 160px 0 60px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .page-title {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .page-desc {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 500px;
  }

  .filter-tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 10px 22px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    cursor: pointer;
    transition: var(--transition);
  }

  .filter-btn:hover {
    border-color: var(--accent-green);
    color: var(--accent-green);
  }

  .filter-btn.active {
    background: var(--accent-green);
    color: var(--bg-primary);
    border-color: var(--accent-green);
    font-weight: 700;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 24px;
  }

  .project-wrapper {
    transition: var(--transition);
  }

  @media (max-width: 1024px) {
    .page-header { padding: 140px 0 50px; }
    .projects-grid { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  }

  @media (max-width: 768px) {
    .page-title { font-size: 2.2rem; }
    .page-desc { font-size: 0.95rem; max-width: 100%; }
    .projects-grid { grid-template-columns: 1fr; gap: 16px; }
    .filter-tabs { justify-content: center; gap: 8px; }
    .filter-btn { padding: 8px 16px; font-size: 0.8rem; }
    .page-header { padding: 120px 0 40px; }
  }

  @media (max-width: 480px) {
    .page-header { padding: 100px 0 28px; }
    .page-title { font-size: 1.8rem; }
    .filter-tabs { gap: 6px; }
    .filter-btn { padding: 6px 12px; font-size: 0.7rem; }
    .projects-grid { gap: 12px; }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectWrappers = document.querySelectorAll('.project-wrapper');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.dataset.filter;
      projectWrappers.forEach(wrapper => {
        if (filter === 'all' || wrapper.dataset.category === filter) {
          wrapper.style.display = 'block';
          wrapper.style.animation = 'none';
          wrapper.offsetHeight; // trigger reflow
          wrapper.style.animation = 'fadeInUp 0.4s ease forwards';
        } else {
          wrapper.style.display = 'none';
        }
      });
    });
  });
</script>
